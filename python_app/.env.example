# Copy to .env, edit values, then export explicitly (Django does not auto-load .env).
# .env is ignored by Git. Never commit merchant credentials or production secrets.
DEBUG=1
DJANGO_SECRET_KEY=local-development-only-do-not-deploy-this-key
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_ORIGIN=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
TRUST_PROXY=0
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Blank DB_NAME uses local SQLite. Use a NEW database for Python, not the Laravel DB.
DB_NAME=
DB_USER=lumiere
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Required when DEBUG=0; Redis must be private and authenticated in production.
REDIS_URL=
# PRIVATE_MEDIA_ROOT=/srv/lumiere/private_media
MAX_VIDEO_BYTES=4294967296

# Start with VNPay Sandbox merchant credentials, never invented/test placeholders.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Local DEBUG=1 email is printed in the terminal. Production requires SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL='Lumiere <noreply@example.com>'

# Optional read-only legacy import. No defaults are read from the old Laravel .env.
LEGACY_DB_NAME=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=lumiere_reader
LEGACY_DB_PASSWORD=
LEGACY_SOURCE_ID=laravel-original
LEGACY_TIME_ZONE=Asia/Ho_Chi_Minh
