[Unit]
Description=Lumiere Django web
After=network.target

[Service]
User=lumiere
Group=lumiere
WorkingDirectory=/srv/lumiere/python_app
EnvironmentFile=/etc/lumiere/env
ExecStart=/srv/lumiere/python_app/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --threads 4 --timeout 120
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lumiere/python_app/private_media /srv/lumiere/python_app/public_media
UMask=0077

[Install]
WantedBy=multi-user.target
